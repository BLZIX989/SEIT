module full_stack_integration;
derive G = build_graph("cycle", 10);
derive A = graph_adjacency(G);
derive L = graph_laplacian(A);
derive S = spectrum(L);
derive H = heat_kernel(L, 1.0);
derive B = ring_incidence_matrix(10, 3);
derive L_A = vertex_laplacian(B);
derive D = block_dirac(B);
derive gamma = grading_operator(B);
derive P = persistence_projector(S, 2.0);
derive L_pi = restricted_laplacian(L, P);
derive H_pi = persistent_heat_operator(L, P, 1.0);
derive K_pi = persistent_heat_trace(H_pi);
derive mu = construct_intersection_matrix(4, 6, 11);
derive clifford_check = verify_clifford_anticommutation(6);
derive gauge_check = h4c_pattern_match_report(L);
derive prereq = spectral_triple_prerequisites_report(D);
derive moments = finite_moment_report(D, 4);
verify symmetric(L);
verify positive_semidefinite(L);
verify symmetric(L_pi);
report;
